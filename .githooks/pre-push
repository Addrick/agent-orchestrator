#!/bin/sh
# DP-250: run the local CI gate before every push so failures surface here, not
# on GitHub. Runs scripts/ci_check.py --no-tests: the STRUCTURAL stages of
# .github/workflows/deploy.yml (flake8 errors -> missing-deps -> mypy ->
# import-linter), which take seconds.
#
# No pytest (DP-452): the full suite already runs on the PR and again on the merge
# to master, so running it here too made one merged PR cost three suite runs, plus
# two more for every extra push. The suite stays a QA_READY requirement — run
# `python scripts/ci_check.py` (or the stricter default pytest) in the worktree
# before calling a change done; this hook just no longer re-runs it on every push.
#
# A push whose commits touch only docs (the CI paths-ignore set, plus CLAUDE.md,
# which no gate stage reads) skips the gate entirely.
#
# Uses the worktree's own .venv if present (so the gate runs against the same
# interpreter/deps as the branch), else falls back to `python` on PATH.
# Escape hatch: `git push --no-verify` skips this (use sparingly).
#
# NOTE (env divergence): the worktree .venv carries the FULL local set (base +
# tooling + voice, per post-checkout), whereas CI installs only the lean
# requirements-dev.txt (no voice). So env-DEPENDENT failures — chiefly the
# DP-249 class where mypy resolves the optional voice_recv import differently
# with/without the dep — can pass this gate yet still go red on GitHub. This gate
# catches lint and the bulk of mypy fast; CI remains the authority for
# the lean-env-only cases.
#
# Tracked + activated via core.hooksPath=.githooks (see scripts/setup-hooks.sh).

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# Docs-only push? stdin carries one "<local ref> <local sha> <remote ref> <remote
# sha>" line per ref being pushed. Diff each against what the remote already has
# (or origin/master for a new branch); any file outside the docs set runs the gate.
# A delete (local sha all zeros) has nothing to check. Anything unparseable falls
# through to running the gate — skipping is the optimisation, never the default.
zero=0000000000000000000000000000000000000000
code_changed=0
while read -r _lref lsha _rref rsha; do
  [ "$lsha" = "$zero" ] && continue
  if [ "$rsha" = "$zero" ]; then
    base=$(git merge-base origin/master "$lsha" 2>/dev/null) || { code_changed=1; break; }
  else
    base=$rsha
  fi
  files=$(git diff --name-only "$base" "$lsha" 2>/dev/null) || { code_changed=1; break; }
  if echo "$files" | grep -vE '^(docs/|\.agents/|readme\.md$|CLAUDE\.md$)' | grep -q .; then
    code_changed=1
    break
  fi
done
if [ "$code_changed" -eq 0 ]; then
  echo "[pre-push] push touches no code — skipping CI gate"
  exit 0
fi

# Pick an interpreter: prefer the worktree venv (Windows uv layout = Scripts/,
# POSIX = bin/), then fall back to python/python3 on PATH.
venv_py=1
if [ -x "$root/.venv/Scripts/python.exe" ]; then
  py="$root/.venv/Scripts/python.exe"
elif [ -x "$root/.venv/bin/python" ]; then
  py="$root/.venv/bin/python"
elif command -v python >/dev/null 2>&1; then
  py=python
  venv_py=0
elif command -v python3 >/dev/null 2>&1; then
  py=python3
  venv_py=0
else
  echo "[pre-push] WARN: no python interpreter found — skipping CI gate" >&2
  exit 0
fi

# A PATH python (no worktree .venv) likely lacks the gate's deps (flake8/mypy/
# pytest). Running anyway yields confusing ModuleNotFound failures that look like
# real gate failures and block the push. Probe first; warn+skip if deps absent.
if [ "$venv_py" -eq 0 ] && ! "$py" -c "import flake8, mypy, pytest" >/dev/null 2>&1; then
  echo "[pre-push] WARN: no worktree .venv and PATH python lacks gate deps — skipping CI gate" >&2
  exit 0
fi

echo "[pre-push] running structural CI gate (scripts/ci_check.py --no-tests) — skip with --no-verify"
( cd "$root" && "$py" scripts/ci_check.py --no-tests )
status=$?
if [ "$status" -ne 0 ]; then
  echo "[pre-push] CI gate FAILED — push aborted. Fix the above, or 'git push --no-verify' to override." >&2
  exit 1
fi
exit 0
