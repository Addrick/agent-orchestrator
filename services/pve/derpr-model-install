#!/bin/bash
# derpr-model-install — the ONE node-side verb behind derpr's install_model tool.
#
# DP-265. Runs on the Proxmox node (not in a guest), because the models
# directory is bind-mounted READ-ONLY into the GPU container — the container
# cannot write the file it will later load.
#
# This script is the security boundary for the whole feature. derpr does not get
# curl, systemctl, or file writes as separate SSH verbs; it gets this, and the
# forced-command wrapper (derpr-pve-wrapper) admits exactly two of its
# subcommands. Widening the key to arbitrary node write in order to simplify the
# handler would trade the entire point away.
#
#   derpr-model-install install <repo> <file> <name> <ctx> <size> <sha256> <job> <kv>
#   derpr-model-install status  <job>
#   derpr-model-install run     <repo> <file> <name> <ctx> <size> <sha256> <job> <kv>
#
# `install` validates, prechecks free space, and hands the long download to
# systemd-run so it survives the SSH disconnect; `run` is what systemd executes
# and is NOT in the wrapper's allowlist — it is reachable only locally.
#
# Design rules that are load-bearing:
#   * Size and sha256 are ARGUMENTS, read from the Hub by derpr and shown on the
#     approval card. This script never asks HuggingFace what the file should be,
#     so what a human approved is what gets enforced. (It also means the node
#     needs no JSON parser — there is no jq on a stock PVE node.)
#   * A sha mismatch DELETES the partial file. Size matching is not proof and
#     has fooled this project before.
#   * The unit is written DISABLED. Putting a model on :5001 is set_active_model's
#     job and gets its own approval.
#   * The unit is written COMPLETE (DP-364). <kv> is the KV precision, proposed
#     by the persona and shown on the approval card; the cache mode is read off
#     the downloaded file, because it follows from the architecture and is not
#     a preference. Every flag the unit runs
#     with is in the unit file: nothing downstream rewrites argv at exec. CT101
#     used to carry exactly that -- a policy wrapper over the koboldcpp binary,
#     because the template hardcoded one --quantkv / --smartcache for every
#     model -- and it also rewrote every non-derpr launch on the box.
#   * Refuse, never truncate, on insufficient space. `df` is the truth only
#     because /srv/models is a plain partition on its own disk (DP-416). When
#     it was a thin LV, df reported the volume's free space and could not see
#     the POOL behind it running out -- it read 75 GiB free over a pool with
#     14 GiB left, passed a 22 GB download, and put every guest on the node
#     into a read-only filesystem (2026-08-21). Never point MODELS_DIR at a
#     thin LV again.

set -uo pipefail

# DP-416: downloads land straight in the directory koboldcpp serves from, so an
# install is servable as soon as it finishes. DP-340 had them land on the
# archive HDD and need a `derpr-model-tier promote` first; that existed only
# because /srv/models was a 120 GiB thin LV, and it is now a dedicated 2 TB disk.
MODELS_DIR="${MODELS_DIR:-/srv/models}"
# Job records live on the archive disk, NOT beside the download. They used to live on
# /srv/models, which meant that when that filesystem went read-only
# the `write_status failed` at the end of the download path could not land --
# the failure record was on the volume the failure had just destroyed. The job
# stayed `running` for 15 hours after the process was dead (2026-08-21).
JOBS_DIR="${JOBS_DIR:-/srv/archive/.jobs}"
CT_VMID="${CT_VMID:-101}"
CT_MODELS_DIR="${CT_MODELS_DIR:-/opt/koboldcpp/models}"
KCPP_DIR="${KCPP_DIR:-/opt/koboldcpp}"
KCPP_PORT="${KCPP_PORT:-5001}"
TEMPLATE="${TEMPLATE:-/usr/local/share/derpr/koboldcpp-model.service.in}"
GGUF_HEADER="${GGUF_HEADER:-/usr/local/share/derpr/gguf_header.py}"
HF_BASE="${HF_BASE:-https://huggingface.co}"
# Headroom kept free beyond the model itself: the larger of 2 GiB and 5% of the
# download, on the archive disk.
MIN_MARGIN_BYTES="${MIN_MARGIN_BYTES:-2147483648}"
# How often the download loop republishes downloaded_bytes.
PROGRESS_INTERVAL="${PROGRESS_INTERVAL:-5}"
# DP-364: what each cache mode writes. Box constants; the mode itself is
# derived per model from the file (see resolve_cache_mode).
#   dense  -> --smartcache $SMARTCACHE_SLOTS       (conversations kept for switching)
#   hybrid -> --smartcachegrid $SMARTCACHEGRID_MB  (checkpoint budget, megabytes)
SMARTCACHE_SLOTS="${SMARTCACHE_SLOTS:-4}"
SMARTCACHEGRID_MB="${SMARTCACHEGRID_MB:-32768}"
# DP-349: the free-space precheck and the reservation ledger are one
# critical section. Without the lock, N concurrent installs each verify the
# same free bytes against themselves and are all admitted into space that
# fits one. The ledger is what makes a concurrent job subtract what is
# already promised rather than only what is already written.
LOCK_FILE="${LOCK_FILE:-$JOBS_DIR/.install.lock}"
RESERVE_DIR="${RESERVE_DIR:-$JOBS_DIR/.reservations}"
# How long to wait for the lock before refusing. A precheck is milliseconds
# of `df`; anything near this means something is wedged holding it.
LOCK_WAIT="${LOCK_WAIT:-60}"
# DP-343 completion ping. Empty URL = no ping, which is the pre-DP-343 behaviour
# and the correct state for a node whose derpr cannot be reached.
DERPR_CALLBACK_URL="${DERPR_CALLBACK_URL:-}"
DERPR_CALLBACK_TIMEOUT="${DERPR_CALLBACK_TIMEOUT:-10}"

# shellcheck source=/dev/null
[ -r /etc/default/derpr-model-install ] && . /etc/default/derpr-model-install

log() { logger -t derpr-model-install -- "$1"; }
die() { echo "derpr-model-install: $1" >&2; log "REFUSE: $1"; exit 1; }

re_repo='^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$'
re_file='^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*\.gguf$'
re_name='^[a-z0-9][a-z0-9-]{0,48}$'
re_job='^[a-z0-9][a-z0-9-]{0,63}$'
re_sha='^[a-f0-9]{64}$'
re_num='^[0-9]+$'
re_kv='^(f16|q8|q4)$'

# ---------------------------------------------------------------------------
# job status
# ---------------------------------------------------------------------------
# Written as JSON because derpr reads it; assembled with printf because the node
# has no jq and because every value here has already been regex-gated, so none
# can carry a quote or a backslash into the document. Nothing from HuggingFace
# (an HTTP body, a curl message) is ever interpolated — the `reason` field is a
# fixed vocabulary. That is what lets install_status declare
# produces_untrusted: False on derpr's side.
# ---------------------------------------------------------------------------
# completion ping (DP-343)
# ---------------------------------------------------------------------------
# A job reaching a terminal state is the one event derpr cannot observe: the
# download is detached under systemd-run precisely so it outlives the SSH call,
# which means nothing on derpr's side is awake when it ends. Until this existed,
# a finished install sat there until a human thought to ask again.
#
# The POST carries the job id and NOTHING else. derpr answers it by re-reading
# the job through the ordinary `status` verb over its own SSH transport, so the
# facts it acts on are the ones it already trusts and a forged ping can at worst
# cause a re-read of a job that has not changed. Sending the status document
# here would make this an input path into a persona's turn; sending an id makes
# it a doorbell.
#
# Best effort, always. The job is finished either way, and a callback that fails
# must never be able to turn a good install into a failed one — so every exit
# path returns 0 and the failure is a log line.
ping_derpr() {
  [ -n "$DERPR_CALLBACK_URL" ] || return 0
  # $JOB matched $re_job before anything here ran, so it cannot carry a quote or
  # a backslash into the body — the same rule that lets write_status build JSON
  # with printf on a node that has no jq.
  if curl -fsS --max-time "$DERPR_CALLBACK_TIMEOUT" --retry 2 --retry-delay 3 \
      --header 'Content-Type: application/json' \
      --data "{\"job_id\":\"$JOB\"}" \
      "$DERPR_CALLBACK_URL" >/dev/null 2>&1; then
    log "callback sent for job=$JOB"
  else
    log "callback FAILED for job=$JOB (derpr not reachable at $DERPR_CALLBACK_URL)"
  fi
  return 0
}

# ---------------------------------------------------------------------------
# space reservations (DP-349)
# ---------------------------------------------------------------------------
# One file per in-flight job, named for the job id:
#   line 1  bytes this job has promised to write
#   line 2  the .part path to delete if the job dies
#   line 3  the unit NAME it is installing
# Read and written only while the install lock is held.

# A reservation whose systemd unit is gone belongs to a job that crashed or
# was killed by a reboot mid-download. Its bytes are not coming, and its
# .part is occupying the space it claimed, so both go. `is-active` is asked
# about the transient unit systemd-run created, which outlives the process
# only while the job is genuinely running.
prune_reservations() {
  local f job part
  [ -d "$RESERVE_DIR" ] || return 0
  for f in "$RESERVE_DIR"/*; do
    [ -e "$f" ] || continue
    job="$(basename "$f")"
    systemctl is-active --quiet "modelinstall-$job" 2>/dev/null && continue
    part="$(sed -n 2p "$f")"
    case "$part" in
      "$MODELS_DIR"/*.part) rm -f "$part" ;;
    esac
    rm -f "$f"
    log "pruned stale reservation job=$job"
  done
}

# Bytes promised by jobs that are still running. Added to what THIS job needs
# so the last admitted job is the one that no longer fits.
reserved_bytes() {
  local f n sum=0
  [ -d "$RESERVE_DIR" ] || { echo 0; return 0; }
  for f in "$RESERVE_DIR"/*; do
    [ -e "$f" ] || continue
    n="$(sed -n 1p "$f" | tr -dc "0-9")"
    [ -n "$n" ] && sum=$(( sum + n ))
  done
  echo "$sum"
}

# Two jobs installing the same NAME would race for one destination file and
# one unit stem. The unit check upstream cannot see this: the second job
# starts before the first has written a unit at all.
name_in_flight() {
  local f
  [ -d "$RESERVE_DIR" ] || return 1
  for f in "$RESERVE_DIR"/*; do
    [ -e "$f" ] || continue
    [ "$(sed -n 3p "$f")" = "$NAME" ] && return 0
  done
  return 1
}

release_reservation() {
  rm -f "$RESERVE_DIR/$JOB"
}

write_status() {
  local state="$1" step="$2" reason="$3" downloaded="$4"
  local tmp="$JOBS_DIR/.$JOB.$$"
  mkdir -p "$JOBS_DIR" || return 1
  printf '{"job_id":"%s","state":"%s","step":"%s","reason":"%s",' \
    "$JOB" "$state" "$step" "$reason" > "$tmp"
  printf '"repo":"%s","file":"%s","name":"%s","unit":"koboldcpp-%s.service",' \
    "$REPO" "$FILE" "$NAME" "$NAME" >> "$tmp"
  printf '"kv_precision":"%s","cache_mode":"%s",' "$KV" "$CACHE_MODE" >> "$tmp"
  printf '"size_bytes":%s,"downloaded_bytes":%s,"contextsize":%s,"sha256":"%s",' \
    "$SIZE" "$downloaded" "$CTX" "$SHA" >> "$tmp"
  printf '"started":"%s","finished":"%s"%s}\n' \
    "$STARTED" "${FINISHED:-}" "${HEADER_JSON:-}" >> "$tmp"
  # Rename into place so a poll never reads a half-written document.
  mv -f "$tmp" "$JOBS_DIR/$JOB.json"
  # DP-343: ping AFTER the rename, never before — derpr's answer to the ping is
  # to read this file, so a ping that overtook the rename would show the state
  # the job just left. Terminal states are written only from `run` (the detached
  # half), so this never delays the SSH-facing verbs.
  case "$state" in
    done|failed) release_reservation; ping_derpr ;;
  esac
}

# ---------------------------------------------------------------------------
# KV precision and cache mode (DP-364)
# ---------------------------------------------------------------------------
# KV precision is approved: f16 | q8 | q4 -> --quantkv 0 | 1 | 2.
#
# The cache mode is NOT a choice; it follows from the architecture, so it is
# read off the downloaded file (resolve_cache_mode, from cmd_run):
#   hybrid (ssm_layers > 0) -> --smartcachegrid $SMARTCACHEGRID_MB
#   dense  (ssm_layers = 0) -> --smartcache $SMARTCACHE_SLOTS
# A hybrid's recurrent state cannot be rewound, so fast-forward cannot reuse a
# prefix after an edit; the grid's checkpoints are what can. A dense KV cache
# truncates, so fast-forward already handles edits, and swap slots are what
# help it switch conversations. Grid on a dense model would be strictly worse,
# not neutral: the fork arms the grid only on a recurrent/hybrid model, while
# koboldcpp.py drops --smartcache whenever --smartcachegrid is set -- leaving a
# dense unit with neither.
resolve_kv() {
  [[ "$SMARTCACHE_SLOTS"  =~ $re_num ]] || die "SMARTCACHE_SLOTS is not a number"
  [[ "$SMARTCACHEGRID_MB" =~ $re_num ]] || die "SMARTCACHEGRID_MB is not a number"
  case "$KV" in
    f16) QUANTKV=0 ;;
    q8)  QUANTKV=1 ;;
    q4)  QUANTKV=2 ;;
  esac
}

# Sets CACHE_MODE / CACHE_FLAGS from the file, or returns 1 when the reader
# cannot say. "Could not tell" is not guessed either way: each guess writes a
# unit that is silently wrong for one of the two architectures.
resolve_cache_mode() {
  local ssm=""
  if [ -r "$GGUF_HEADER" ] && command -v python3 >/dev/null 2>&1; then
    ssm="$(python3 "$GGUF_HEADER" --ssm-layers "$DEST" 2>/dev/null)" || ssm=""
  fi
  [[ "$ssm" =~ $re_num ]] || return 1
  if [ "$ssm" -gt 0 ]; then
    CACHE_MODE=grid; CACHE_FLAGS=" --smartcachegrid $SMARTCACHEGRID_MB"
  else
    CACHE_MODE=swap; CACHE_FLAGS=" --smartcache $SMARTCACHE_SLOTS"
  fi
}

# ---------------------------------------------------------------------------
# argument gate
# ---------------------------------------------------------------------------
parse_job_args() {
  [ "$#" -eq 8 ] || die "expected 8 arguments, got $#"
  REPO="$1"; FILE="$2"; NAME="$3"; CTX="$4"; SIZE="$5"; SHA="$6"; JOB="$7"
  KV="$8"
  CACHE_MODE=""; CACHE_FLAGS=""
  [[ "$REPO" =~ $re_repo ]] || die "invalid repo"
  [[ "$FILE" =~ $re_file ]] || die "invalid file"
  [[ "$FILE" != *".."* ]]   || die "invalid file"
  [[ "$NAME" =~ $re_name ]] || die "invalid name"
  [[ "$CTX"  =~ $re_num  ]] || die "invalid contextsize"
  [[ "$SIZE" =~ $re_num  ]] || die "invalid size"
  [[ "$SHA"  =~ $re_sha  ]] || die "invalid sha256"
  [[ "$JOB"  =~ $re_job  ]] || die "invalid job id"
  [[ "$KV" =~ $re_kv ]] || die "invalid kv precision"
  resolve_kv
  # The destination basename comes from $NAME, not from the repo file name.
  # Two unrelated repos both publishing `model-Q4_K_M.gguf` is ordinary, and
  # under a repo-derived basename the second is uninstallable while its
  # `.part` clobbers the first's in-flight download. $NAME is unique by
  # construction: the unit stem `koboldcpp-$NAME.service` must not already
  # exist. re_name excludes "/" and ".", so the directory stays flat, which
  # the wrapper's allowlist requires - it pins the model path to
  # <dir>/<file>.gguf with no subdirectory.
  BASENAME="$NAME.gguf"
  DEST="$MODELS_DIR/$BASENAME"
  UNIT="koboldcpp-$NAME.service"
  STARTED="${STARTED:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  FINISHED=""
  HEADER_JSON=""
}

# ---------------------------------------------------------------------------
# install — validate, precheck, detach
# ---------------------------------------------------------------------------
cmd_install() {
  parse_job_args "$@"
  [ -x "$0" ] || die "installer not executable"
  [ -r "$TEMPLATE" ] || die "unit template missing at $TEMPLATE"
  [ -d "$MODELS_DIR" ] || die "models dir $MODELS_DIR does not exist"

  # Everything from here to systemd-run is one critical section. The whole
  # defect is that the precheck and the commit were separable: two jobs both
  # read the same `avail`, both decided they fit, and both started.
  mkdir -p "$JOBS_DIR" "$RESERVE_DIR" || die "could not create $RESERVE_DIR"
  exec 9>"$LOCK_FILE" || die "could not open lock file $LOCK_FILE"
  flock -w "$LOCK_WAIT" 9 || die "timed out waiting for the install lock"
  # Drop claims belonging to jobs that are no longer running, so a crash or a
  # reboot mid-download does not permanently shrink the disk on paper.
  prune_reservations
  if name_in_flight; then
    die "another install job is already installing $NAME"
  fi

  # Refuse to shadow an existing unit. Overwriting one would silently repoint
  # a name list_models already publishes, which is the sort of change that
  # gets discovered by a swap serving the wrong model.
  #
  # The probe must return a POSITIVE "absent". A failing `pct exec test -f`
  # is not evidence the unit is absent -- it is equally "container stopped,
  # locked, or unreachable", and reading that as absent disarms the guard at
  # exactly the moment the box cannot be consulted.
  local unit_probe
  unit_probe="$(pct exec "$CT_VMID" -- sh -c \
    "test -f /etc/systemd/system/$UNIT && echo present || echo absent" \
    2>/dev/null)"
  case "$unit_probe" in
    absent)  : ;;
    present) die "unit $UNIT already exists on CT $CT_VMID; choose another name" ;;
    *) die "could not determine whether $UNIT exists on CT $CT_VMID" ;;
  esac
  if [ -e "$JOBS_DIR/$JOB.json" ]; then
    die "job $JOB already exists"
  fi

  # A file already on disk is only reusable if it is byte-identical to what was
  # approved. Same name, different bytes is the dangerous case, so it is a
  # refusal rather than an overwrite.
  if [ -e "$DEST" ]; then
    local have
    have="$(sha256sum "$DEST" | cut -d' ' -f1)"
    [ "$have" = "$SHA" ] || die "$BASENAME already exists with a different sha256"
  else
    local avail need promised
    avail="$(df -B1 --output=avail "$MODELS_DIR" | tail -n1 | tr -dc '0-9')"
    [ -n "$avail" ] || die "could not read free space on $MODELS_DIR"
    need=$(( SIZE + (SIZE / 20) ))
    [ "$need" -ge $(( SIZE + MIN_MARGIN_BYTES )) ] || need=$(( SIZE + MIN_MARGIN_BYTES ))
    # Space already promised by running jobs is space this one cannot have,
    # even though `df` still reports it free: their bytes are in flight, not
    # yet written. Subtracting only what is on disk is what let N jobs share
    # one job's worth of room.
    promised="$(reserved_bytes)"
    need=$(( need + promised ))
    if [ "$avail" -lt "$need" ]; then
      die "insufficient space on $MODELS_DIR: need $need bytes (including $promised reserved by running jobs), have $avail"
    fi
  fi

  # Claim the space before releasing the lock. A reservation written after
  # systemd-run would leave a window in which the job is running and its
  # bytes are invisible to the next precheck -- the same race, moved.
  printf '%s\n%s\n%s\n' "$SIZE" "$DEST.part" "$NAME" > "$RESERVE_DIR/$JOB" \
    || die "could not write reservation for job $JOB"

  write_status queued starting "" 0 || die "could not write job file"
  # --collect so a finished unit does not linger in a failed state and block the
  # next job that reuses the name (job ids are unique, but a re-run after a crash
  # is exactly when that would bite).
  systemd-run --collect --unit="modelinstall-$JOB" \
    --setenv=STARTED="$STARTED" \
    "$0" run "$REPO" "$FILE" "$NAME" "$CTX" "$SIZE" "$SHA" "$JOB" "$KV" >/dev/null 2>&1 \
    || { release_reservation; die "could not start background job"; }
  log "ALLOW install $REPO/$FILE as $NAME job=$JOB"
  cat "$JOBS_DIR/$JOB.json"
}

# ---------------------------------------------------------------------------
# status — the only other verb the wrapper admits
# ---------------------------------------------------------------------------
cmd_status() {
  [ "$#" -eq 1 ] || die "status takes exactly one job id"
  local job="$1"
  [[ "$job" =~ $re_job ]] || die "invalid job id"
  local path="$JOBS_DIR/$job.json"
  [ -r "$path" ] || die "no such job: $job"
  cat "$path"
}

# ---------------------------------------------------------------------------
# run — executed by systemd, never by sshd
# ---------------------------------------------------------------------------
cmd_run() {
  parse_job_args "$@"
  local part="$DEST.part"

  if [ -e "$DEST" ]; then
    # Verified identical during `install`; nothing to fetch.
    write_status running unit "" "$SIZE"
  else
    write_status running download "" 0
    local url="$HF_BASE/$REPO/resolve/main/$FILE"
    rm -f "$part"
    # --max-filesize bounds the write by the size a human approved. Without
    # it a repo serving more bytes than it advertised fills the disk FIRST
    # and fails the digest check afterwards, which is the wrong order to
    # find out. Anonymous: no token, no Authorization header (DP-347).
    curl -fL --retry 3 --retry-delay 5 --silent --show-error \
      --max-filesize "$SIZE" -o "$part" "$url" &
    local pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      local got
      got="$(stat -c %s "$part" 2>/dev/null || echo 0)"
      write_status running download "" "$got"
      sleep "$PROGRESS_INTERVAL"
    done
    wait "$pid"
    local rc=$?
    if [ "$rc" -ne 0 ]; then
      rm -f "$part"
      FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      write_status failed download "download_failed" 0
      log "FAIL job=$JOB download rc=$rc"
      exit 1
    fi

    # A pre-filter, never the check: hashing 30 GB to learn what `stat`
    # already knew costs minutes of node I/O, and a byte count that
    # disagrees cannot possibly hash correctly.
    local got_bytes
    got_bytes="$(stat -c %s "$part" 2>/dev/null || echo 0)"
    if [ "$got_bytes" != "$SIZE" ]; then
      rm -f "$part"
      FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      write_status failed verify "size_mismatch" 0
      log "FAIL job=$JOB size mismatch: got $got_bytes want $SIZE"
      exit 1
    fi

    # The verify, not the size, is the check. A truncated or substituted file can
    # match a byte count; it cannot match the digest a human approved.
    write_status running verify "" "$SIZE"
    local got_sha
    got_sha="$(sha256sum "$part" | cut -d' ' -f1)"
    if [ "$got_sha" != "$SHA" ]; then
      rm -f "$part"
      FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      write_status failed verify "sha256_mismatch" 0
      log "FAIL job=$JOB sha mismatch"
      exit 1
    fi
    mv -f "$part" "$DEST"
    # World-readable is what lets the UNPRIVILEGED container read the file;
    # nobody:nogroup inside the CT is expected, not a bug.
    chmod 644 "$DEST"
  fi

  # Header facts about the file: the cached-layer shape, the SSM block count
  # that says whether it is hybrid, or the reason its cache is not linear in
  # context. Best effort -- a parse failure must not fail an install whose
  # bytes are good.
  #
  # DP-360: gate on the producer's EXIT STATUS, never on a pattern matched
  # against its output. This gate used to require a leading ,"n_layer", which
  # accepted the shape and silently discarded everything else gguf_header.py
  # can emit -- a gemma4 model returns ,"kv_shape_note":... as its FIRST key,
  # so its refusal, the one output that exists specifically to stop a wrong
  # estimate, never reached the job status at all. Widening that glob would
  # just move the bug: any pattern here is this script re-deriving a grammar
  # it does not own, and it has to be re-widened for every key gguf_header.py
  # ever grows. The producer owns the grammar and validates its own output
  # before printing it; exit 0 is its promise that stdout is a COMPLETE
  # fragment, empty included. Anything else means it died before it could
  # promise that -- an unhandled error, an OOM kill, a half-finished write --
  # and a partial fragment spliced into the status document makes the whole
  # job record unparseable for derpr, which reports it as "no readable status".
  if [ -r "$GGUF_HEADER" ] && command -v python3 >/dev/null 2>&1; then
    # Declared on its own line on purpose: `local hdr="$(...)"` would make the
    # exit status that of `local`, which is always 0, and this gate would
    # accept every crash it exists to reject.
    local hdr
    if hdr="$(python3 "$GGUF_HEADER" "$DEST" 2>/dev/null)"; then
      HEADER_JSON="$hdr"
    else
      HEADER_JSON=""
    fi
  fi

  # DP-364: the cache mode, from the file. The verified bytes stay in the
  # archive on a refusal, so a retry once the reader is fixed reuses them.
  if ! resolve_cache_mode; then
    FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_status failed unit "cache_mode_unknown" "$SIZE"
    log "FAIL job=$JOB could not read ssm_layers from $DEST; no unit written"
    exit 1
  fi

  write_status running unit "" "$SIZE"
  local tmp="/tmp/derpr-$UNIT.$$"
  sed -e "s|@@NAME@@|$NAME|g" \
      -e "s|@@JOB_ID@@|$JOB|g" \
      -e "s|@@KV@@|$KV|g" \
      -e "s|@@CACHE_MODE@@|$CACHE_MODE|g" \
      -e "s|@@KCPP_DIR@@|$KCPP_DIR|g" \
      -e "s|@@MODEL_PATH@@|$CT_MODELS_DIR/$BASENAME|g" \
      -e "s|@@PORT@@|$KCPP_PORT|g" \
      -e "s|@@CONTEXTSIZE@@|$CTX|g" \
      -e "s|@@QUANTKV@@|$QUANTKV|g" \
      -e "s|@@CACHE_FLAGS@@|$CACHE_FLAGS|g" \
      "$TEMPLATE" > "$tmp" || { write_status failed unit "template_failed" "$SIZE"; exit 1; }

  if ! pct push "$CT_VMID" "$tmp" "/etc/systemd/system/$UNIT" --perms 644; then
    rm -f "$tmp"
    FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_status failed unit "unit_write_failed" "$SIZE"
    exit 1
  fi
  rm -f "$tmp"

  # The shared logging drop-in: kcpp's progress records end in CR, and without
  # this they land in the journal as one line per byte-batch. Cosmetic, so a
  # failure here is RECORDED and not fatal -- but it is no longer invisible.
  # Silently discarding the exit status is how a step gets reported done on
  # the strength of having been attempted.
  local dropin="/tmp/derpr-log-$NAME.$$"
  printf '[Service]\nStandardOutput=append:/var/log/kobold/current.log\nStandardError=append:/var/log/kobold/current.log\n' > "$dropin"
  if pct exec "$CT_VMID" -- mkdir -p "/etc/systemd/system/$UNIT.d" >/dev/null 2>&1 \
     && pct push "$CT_VMID" "$dropin" "/etc/systemd/system/$UNIT.d/log.conf" \
          --perms 644 >/dev/null 2>&1; then
    :
  else
    log "WARN job=$JOB logging drop-in not installed for $UNIT (cosmetic)"
  fi
  rm -f "$dropin"

  # A unit systemd has not re-read does not exist to `systemctl
  # list-unit-files`, which is exactly where list_models discovers units. So
  # the reload is checked, and then the box is ASKED whether the unit is
  # actually loaded -- reporting this step done off a discarded exit status
  # is how an install lands "done" with nothing to show for it.
  if ! pct exec "$CT_VMID" -- systemctl daemon-reload >/dev/null 2>&1; then
    FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_status failed unit "daemon_reload_failed" "$SIZE"
    log "FAIL job=$JOB daemon-reload on CT $CT_VMID"
    exit 1
  fi

  # A POSITIVE answer, for the same reason the pre-install probe demands one:
  # a failing `pct exec` is not evidence about the unit, it is evidence about
  # the container.
  local loaded
  loaded="$(pct exec "$CT_VMID" -- systemctl show -p LoadState --value \
    "$UNIT" 2>/dev/null)"
  if [ "$loaded" != "loaded" ]; then
    FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    write_status failed unit "unit_not_loaded" "$SIZE"
    log "FAIL job=$JOB $UNIT LoadState=${loaded:-unknown} after daemon-reload"
    exit 1
  fi

  # Deliberately NOT enabled and NOT started. Taking :5001 is a separate,
  # separately-approved action.
  FINISHED="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  write_status done installed "" "$SIZE"
  log "DONE job=$JOB $REPO/$FILE -> $UNIT (disabled)"
}

case "${1:-}" in
  install) shift; cmd_install "$@" ;;
  status)  shift; cmd_status  "$@" ;;
  run)     shift; cmd_run     "$@" ;;
  *) die "usage: derpr-model-install install|status|run ..." ;;
esac
