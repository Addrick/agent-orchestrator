#!/bin/bash
# derpr-egress — the node-side verb behind each sandbox box's WAN (DP-456, DP-465).
#
# A box (codr-vm, stagr-vm) reaches the internet only through its own tinyproxy
# instance in the egress container, which admits only allowlisted hosts. derpr
# flips that WAN and approves hosts here, over the same SSH key and wrapper as
# every other node tool:
#
#   derpr-egress <box> on|off|status   the WAN switch
#   derpr-egress <box> allow <host>    after a human approved request_web_access
#   derpr-egress <box> list|conns|log  allowlist, live tunnels, recent log
#
# Installed at /usr/local/sbin/derpr-egress on the node that hosts the egress
# container. The container's own egress-ctl (services/egress/) does the work;
# this only checks the arguments and forwards them with `pct exec`.
set -euo pipefail

ct="${DERPR_EGRESS_CT:-110}"
ctl=/usr/local/sbin/egress-ctl
# Same gate as src/stagr/net.py and egress-ctl. The last label starts with a
# letter, so no IP literal gets through.
host_re='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$'

die() { echo "derpr-egress: $1" >&2; exit 1; }
usage() { die "usage: derpr-egress <codr|stagr> {on|off|status|list|conns|log|allow <host>}"; }

case "${1:-}" in codr|stagr) ;; *) usage ;; esac
case "${2:-}" in
  on|off|status|list|conns|log)
    [ "$#" -eq 2 ] || usage
    exec pct exec "$ct" -- "$ctl" "$1" "$2"
    ;;
  allow)
    [ "$#" -eq 3 ] || usage
    [ "${#3}" -le 253 ] && [[ "$3" =~ $host_re ]] || die "not a host name: $3"
    exec pct exec "$ct" -- "$ctl" "$1" allow "$3"
    ;;
  *) usage ;;
esac
