flowchart TB
    %% ---------- 1. Client Interfaces & Security Edge ----------
    subgraph EDGE["1. Client Interfaces &amp; Security Edge"]
        direction LR
        BOOTSTRAP["<b>Bootstrap Root</b><br/><i>src/bootstrap/</i>"]
        VAULT["<b>CredentialVault</b><br/><i>vault.py</i>"]
        SCRUB["<b>Egress &amp; Log Scrubber</b><br/><i>scrubber.py</i>"]
        DISCORD["<b>Discord Bot</b><br/><i>discord_bot.py</i>"]
        GMAIL["<b>Gmail Bot</b><br/><i>gmail_bot.py (PoC)</i>"]
        PORTAL["<b>KoboldAdapter</b><br/><i>/portal · FastAPI</i>"]
    end

    %% ---------- 2. Core Orchestration Engine Monolith ----------
    subgraph CORE["2. Core Orchestration Engine Monolith"]
        direction TB
        CHAT["<b>ChatSystem Kernel</b><br/><i>chat_system.py</i>"]
        subgraph KERNEL_COLLAB["Kernel Collaborators"]
            direction LR
            BL["<b>BotLogic</b><br/><i>message_handler.py</i>"]
            PER["<b>PersonaStore</b><br/><i>persona.py</i>"]
            REQ["<b>RequestBuilder</b><br/><i>request_builder.py</i>"]
            CONF["<b>ConfirmationManager</b><br/><i>confirmations.py</i>"]
            PERSIST["<b>TurnPersistence</b><br/><i>turn_persistence.py</i>"]
        end
    end

    %% ---------- 3. Pluggable Drivers & Tooling Engine ----------
    subgraph DRIVERS["3. Pluggable Drivers &amp; Tooling Engine"]
        direction TB
        LOOP["<b>ToolLoop Engine</b><br/><i>tool_loop.py · max 5 iterations</i>"]
        subgraph DRIVER_SERVICES["Execution Drivers &amp; Extensions"]
            direction LR
            ENG["<b>TextEngine</b><br/><i>stream_engine.py</i>"]
            TM["<b>ToolManager Registry</b><br/><i>tool_manager.py</i>"]
            MCP["<b>MCP Bridge &amp; Client</b><br/><i>mcp_bridge / mcp_client</i>"]
            PROP["<b>Proposal Engine</b><br/><i>service &amp; executor</i>"]
        end
    end

    %% ---------- 4. Tiered Memory Subsystem ----------
    subgraph MEMORY["4. Tiered Memory Subsystem"]
        direction TB
        MM["<b>MemoryManager</b><br/><i>memory_manager.py</i>"]
        ROUTER["<b>MemoryRouter</b><br/><i>router.py</i>"]
        BABC{{"<b>MemoryBackend ABC</b>"}}
        subgraph BACKENDS["Memory Storage Backends"]
            direction LR
            BSQL["<b>SqliteSemanticBackend</b><br/><i>sqlite-vec (default)</i>"]
            BHIND["<b>HindsightBackend</b><br/><i>REST · Postgres/pgvector</i>"]
            EMB["<b>EmbeddingService</b><br/><i>gemini-embedding-001</i>"]
        end
    end

    %% ---------- 5. Background Worker Fleet ----------
    subgraph FLEET["5. Autonomous Background Worker Fleet"]
        direction TB
        APP["<b>AppManager Lifecycle</b><br/><i>app_manager.py</i>"]
        AGM["<b>AgentManager Dispatcher</b><br/><i>agent_manager.py</i>"]
        subgraph WORKERS["Isolated Autonomous Agents"]
            direction LR
            SC["<b>SqliteConsolidator</b><br/><i>15m episodic chunking</i>"]
            MC["<b>MemoryConsolidator</b><br/><i>hourly L1 &rarr; L2 merging</i>"]
            ZA["<b>ZammadBot</b><br/><i>ticket triage pipeline</i>"]
            DA["<b>DispatchAgent</b><br/><i>priority &amp; routing</i>"]
            MANAGR["<b>ManagrAgent</b><br/><i>autonomous workflows</i>"]
            REMIND["<b>ReminderAgent</b><br/><i>scheduled reminders</i>"]
        end
        NR["<b>NotificationRouter</b><br/><i>Discord / Zammad / Log</i>"]
    end

    %% ---------- 6. External Services & Container Storage ----------
    subgraph EXTERNAL["6. External Services &amp; Container Infrastructure"]
        direction LR
        LLM[("<b>LLM Provider APIs</b><br/>OpenAI · Anthropic · Gemini · Local OAI")]
        ZAPI[("<b>Zammad REST API</b>")]
        SQLITE[("<b>SQLite DB File</b><br/>User_Interactions · vec_*")]
        HDB[("<b>Hindsight Container</b><br/>Postgres + pgvector")]
    end

    %% ---------- Edges & Data Flow ----------
    BOOTSTRAP --> CHAT
    BOOTSTRAP --> VAULT
    BOOTSTRAP --> SCRUB

    DISCORD --> CHAT
    GMAIL --> CHAT
    PORTAL --> CHAT

    CHAT --> BL
    CHAT --> PER
    CHAT --> REQ
    CHAT --> LOOP
    CHAT --> CONF
    CHAT --> PERSIST

    REQ --> MM
    REQ -. "Memory Recall" .-> ROUTER
    ROUTER --> BABC

    LOOP --> ENG
    LOOP --> TM
    TM --> MCP
    TM --> PROP
    ENG -.-> LLM

    PERSIST --> MM
    CONF --> MM

    MM --> BABC
    BABC ==> BSQL
    BABC ==> BHIND
    BSQL -.-> SQLITE
    BHIND -.-> HDB
    MM -.-> SQLITE
    REQ -.-> EMB
    BSQL -.-> EMB

    APP --> AGM
    APP -.-> CHAT
    AGM --> SC
    AGM --> MC
    AGM --> ZA
    AGM --> DA
    AGM --> MANAGR
    AGM --> REMIND

    SC -.-> MM
    MC -.-> MM
    ZA -.-> ZAPI
    DA --> NR
    DA -.-> ZAPI
    MANAGR -.-> CHAT
    REMIND -.-> NR
    NR -.-> DISCORD

