    classDef mem_style fill:#E8F5E9,stroke:#455A64,color:#1A1A1A;
    classDef fleet_style fill:#FCE4EC,stroke:#455A64,color:#1A1A1A;
    classDef ext_style fill:#ECEFF1,stroke:#455A64,color:#1A1A1A;

    class BOOTSTRAP,VAULT,SCRUB,DISCORD,GMAIL,PORTAL edge_style;
    class CHAT,BL,PER,REQ,CONF,PERSIST core_style;
    class LOOP,ENG,TM,MCP,PROP driver_style;
    class MM,ROUTER,BABC,BSQL,BHIND,EMB mem_style;
    class APP,AGM,SC,MC,ZA,DA,MANAGR,REMIND,NR fleet_style;
    class LLM,ZAPI,SQLITE,HDB ext_style;
